# syntax=docker/dockerfile:1

###############################################################################
# Build stage
###############################################################################
FROM rust:1-bookworm AS build

WORKDIR /build

# Audio codec libraries for Opus decode + MP3 encode.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libopus-dev libmp3lame-dev \
    && rm -rf /var/lib/apt/lists/*

# Cache dependencies.
COPY Cargo.toml Cargo.lock ./
COPY crates/lk-proto/Cargo.toml crates/lk-proto/Cargo.toml
COPY crates/lk-psrpc/Cargo.toml crates/lk-psrpc/Cargo.toml
COPY crates/lk-egress/Cargo.toml crates/lk-egress/Cargo.toml
COPY crates/lk-server/Cargo.toml crates/lk-server/Cargo.toml
RUN mkdir -p crates/lk-proto/src crates/lk-psrpc/src crates/lk-egress/src crates/lk-server/src \
    && echo '' > crates/lk-proto/src/lib.rs \
    && echo '' > crates/lk-psrpc/src/lib.rs \
    && echo '' > crates/lk-egress/src/lib.rs \
    && echo 'fn main() {}' > crates/lk-egress/src/main.rs \
    && echo '' > crates/lk-proto/build.rs \
    && echo '' > crates/lk-egress/build.rs \
    && touch crates/lk-server/src/lib.rs crates/lk-server/src/main.rs \
    && cargo build --release -p lk-egress 2>/dev/null || true

# Real sources.
COPY . .
RUN cargo build --release -p lk-egress

# Stage the audio codec libraries at a fixed path (works for any arch).
RUN mkdir -p /libs \
    && cp /usr/lib/*/libopus.so.0* /libs/ \
    && cp /usr/lib/*/libmp3lame.so.0* /libs/

###############################################################################
# Runtime stage
###############################################################################
FROM gcr.io/distroless/cc-debian12

# Audio codec shared libraries (glibc + CA certs come from the base image).
COPY --from=build /libs/ /libs/
ENV LD_LIBRARY_PATH=/libs
COPY --from=build /build/target/release/livekit-egress /usr/local/bin/livekit-egress

# Recordings are written here (mount a volume).
VOLUME ["/out"]

ENTRYPOINT ["livekit-egress"]
CMD ["--config", "/etc/livekit-egress/egress.yaml"]
