# syntax=docker/dockerfile:1

###############################################################################
# Build stage
###############################################################################
# Builds the `publisher` used by the egress benchmark harness for the Go stack.
# It uses the reference Go SDK (pion + cgo libopus/opusfile/soxr), which
# interoperates with the Go livekit-server over DTLS-SRTP where the Rust
# webrtc-rs publisher cannot.
FROM golang:1.26-bookworm AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config \
       libopus-dev libopusfile-dev libsoxr-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY scripts/bench/go-publisher/go.mod scripts/bench/go-publisher/go.sum ./
RUN go mod download
COPY scripts/bench/go-publisher/ ./
RUN CGO_ENABLED=1 go build -o /publisher .

###############################################################################
# Runtime stage
###############################################################################
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libopus0 libopusfile0 libsoxr0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /publisher /usr/local/bin/publisher

ENTRYPOINT ["publisher"]
